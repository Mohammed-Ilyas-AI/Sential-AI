{
  "name": "sentinel-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SENTINEL AI - real-time fraud operations control tower for retail banking",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "workspaces": [
    "packages/domain",
    "packages/rules",
    "packages/scenarios",
    "apps/core",
    "apps/stream",
    "apps/simulator",
    "apps/ui"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace @sentinel/domain --workspace @sentinel/rules --workspace @sentinel/scenarios",
    "predev": "npm run build:packages",
    "dev": "run-p dev:core dev:stream dev:ui",
    "presimulate": "npm run build:packages",
    "simulate": "npm run dev --workspace @sentinel/simulator",
    "simulate:when-ready": "node tools/local-dev/wait-for.mjs http://localhost:8080/healthz http://localhost:8081/healthz http://localhost:4200/ && npm run dev --workspace @sentinel/simulator",
    "doctor": "node --env-file-if-exists=.env tools/local-dev/doctor.mjs",
    "predemo": "npm run doctor",
    "demo": "run-p dev simulate:when-ready",
    "dev:core": "npm run dev --workspace @sentinel/core",
    "dev:stream": "npm run dev --workspace @sentinel/stream",
    "dev:ui": "npm run start --workspace @sentinel/ui",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:scenario": "npm run test:scenario --workspace @sentinel/core",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "angular-eslint": "~22.5.0",
    "eslint": "~10.11.0",
    "npm-run-all2": "~9.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.70.1",
    "vitest": "~5.0.2"
  }
}
