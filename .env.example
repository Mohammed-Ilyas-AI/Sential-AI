# --- API ---
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# --- Google Cloud ---
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
PUBSUB_TOPIC_TRANSACTIONS=sentinel-transactions
PUBSUB_SUBSCRIPTION_SCORING=sentinel-scoring-sub

# --- Vertex AI / Gemini ---
VERTEX_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-2.5-pro

# --- Rapid-drain policy (Singapore SRF) ---
RAPID_DRAIN_WINDOW_MINUTES=60
RAPID_DRAIN_BALANCE_PCT=50
RAPID_DRAIN_MIN_AMOUNT_SGD=1000
