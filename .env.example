# Local development only. Placeholders, never real values.
# On Cloud Run these come from service configuration and Secret Manager (see infra/).

# --- Shared ---
LOG_LEVEL=debug
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1

# --- sentinel-core ---
PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:4200
# Secret Manager secret "mongodb-uri" in deployed environments.
MONGODB_URI=
MONGODB_DATABASE=sentinel_ai
# Integration tests (npm run test:integration) always use an isolated throwaway database derived from this name.
# Pub/Sub push authentication: google-oidc in every deployed environment.
PUBSUB_PUSH_VERIFICATION=disabled-for-local-development
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
# Gemini: gemini-api (needs GEMINI_API_KEY) or vertex-ai (application default credentials, no key).
# Unset: a key selects gemini-api. Deployed, the key comes from Secret Manager (gemini-api-key); never commit one.
GEMINI_PROVIDER=
GEMINI_API_KEY=
# Model identifiers are configuration, never literals in code (verified 14 Oct 2026: gemini-3.5-flash,
# gemini-3.1-pro-preview). Empty: the advisory and the agent report MODEL_NOT_CONFIGURED.
VERTEX_LOCATION=asia-southeast1
GEMINI_FAST_MODEL=
GEMINI_DEEP_MODEL=
# Rapid-drain policy overrides. Defaults live in packages/domain (SG-RD-1.0);
# any override must also change RAPID_DRAIN_POLICY_VERSION.
RAPID_DRAIN_POLICY_VERSION=SG-RD-1.0
RAPID_DRAIN_PROTECTED_BALANCE_MINOR=5000000
RAPID_DRAIN_GATE_PERCENT=50
RAPID_DRAIN_HOLD_HOURS=24
# Synthetic payee ids of designated billing organisations (bill payments to them bypass the safeguard).
DESIGNATED_BILLING_PAYEE_IDS=
# Demo only: compresses the 24h hold to 24s, labelled "demo time x3600" in the UI.
DEMO_TIME_COMPRESSION_ENABLED=false

# Local development only: if Node cannot resolve mongodb+srv:// (querySrv ECONNREFUSED) although the OS can,
# point the dev scripts' DNS at public resolvers. Never set in deployed environments.
# SENTINEL_DEV_DNS_SERVERS=8.8.8.8,1.1.1.1

# --- sentinel-stream ---
STREAM_PORT=8081
# Browsers may only open the stream from the UI origin.
STREAM_ALLOWED_ORIGIN=http://localhost:4200
STREAM_HEARTBEAT_INTERVAL_MS=25000

# --- sentinel-simulator ---
SIMULATOR_CORE_BASE_URL=http://localhost:8080
SIMULATOR_PUBSUB_TOPIC=sentinel-transaction-events
SIMULATOR_SCENARIO_ID=DEMO_TAKEOVER_01
# Optional. Unset: every simulator start is a new run with fresh synthetic identifiers. Set (1-12 letters or
# digits) to replay one run exactly; the core then deduplicates every event in it.
SIMULATOR_RUN_ID=
# pubsub (ordered by sourceAccountToken; needs GCP_PROJECT_ID) or direct-push (local: posts push envelopes to core).
SIMULATOR_EVENT_TRANSPORT=direct-push
# realtime (the documented beat timings) or instant.
SIMULATOR_TIMELINE=realtime

# --- sentinel-ui ---
# The UI reads apps/ui runtime-config.json at startup (coreApiBaseUrl, streamUrl, demoTimeCompression);
# without it, it uses http://localhost:8080 and ws://localhost:8081/stream.
