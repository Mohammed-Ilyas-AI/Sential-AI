{
  "name": "@sentinel/stream",
  "version": "0.1.0",
  "private": true,
  "description": "sentinel-stream: WebSocket gateway. Transport only; watches decisions, alerts and interventions.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --import ../../tools/local-dev/dns-resolvers.mjs src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project stream",
    "test:integration": "vitest run --config ../../vitest.config.ts --project stream-integration"
  },
  "dependencies": {
    "@sentinel/domain": "0.1.0",
    "mongodb": "~7.6.0",
    "pino": "~10.3.1",
    "ws": "~8.21.3"
  },
  "devDependencies": {
    "@types/node": "~22.20.4",
    "@types/ws": "~8.18.1",
    "tsx": "~4.23.15"
  }
}
