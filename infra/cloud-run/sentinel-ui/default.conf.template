# nginx template: the image's entrypoint substitutes ${CORE_API_BASE_URL}, ${STREAM_URL}, ${DEMO_TIME_COMPRESSION},
# ${PUBLIC_UI_ORIGIN} and ${PUBLIC_UI_HOST} from the container environment at start (only variables that are set,
# so nginx's own $uri is untouched) and writes /etc/nginx/conf.d/default.conf.

# The application has one public address. A page opened under any other hostname (the generated run.app URLs)
# is sent there, so the address bar never shows infrastructure. Local runs keep working on localhost.
map $host $sentinel_other_host {
  default 1;
  ${PUBLIC_UI_HOST} 0;
  localhost 0;
  127.0.0.1 0;
}

server {
  listen 8080;
  root /usr/share/nginx/html;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  # The browser's endpoints for this deployment. Overrides the localhost file baked into the build; never a secret.
  location = /runtime-config.json {
    default_type application/json;
    add_header Cache-Control 'no-store' always;
    return 200 '{"coreApiBaseUrl":"${CORE_API_BASE_URL}","streamUrl":"${STREAM_URL}","demoTimeCompression":${DEMO_TIME_COMPRESSION}}';
  }

  location = /index.html {
    if ($sentinel_other_host) {
      return 301 ${PUBLIC_UI_ORIGIN}/;
    }
    add_header Cache-Control 'no-cache' always;
  }

  location / {
    if ($sentinel_other_host) {
      return 301 ${PUBLIC_UI_ORIGIN}$request_uri;
    }
    try_files $uri $uri/ /index.html;
  }
}
