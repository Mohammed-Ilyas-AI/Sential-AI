# sentinel-core configuration surface. Placeholders only; see apps/core/src/config/config-validation.ts.
PORT=8080
LOG_LEVEL=info
GCP_PROJECT_ID=<project-id>
GEMINI_PROVIDER=gemini-api | vertex-ai
GEMINI_API_KEY=<from Secret Manager: gemini-api-key; gemini-api only>
VERTEX_LOCATION=asia-southeast1
GEMINI_FAST_MODEL=<verified fast-tier model id>
GEMINI_DEEP_MODEL=<verified deep-tier model id>
CORS_ALLOWED_ORIGIN=<sentinel-ui origin>[,<other exact UI origin>...]
MONGODB_URI=<from Secret Manager: mongodb-uri>
MONGODB_DATABASE=sentinel_ai
RAPID_DRAIN_POLICY_VERSION=SG-RD-1.0
DESIGNATED_BILLING_PAYEE_IDS=<comma-separated synthetic payee ids>
DEMO_TIME_COMPRESSION_ENABLED=false
PUBSUB_PUSH_VERIFICATION=google-oidc
PUBSUB_PUSH_AUDIENCE=<sentinel-core push endpoint URL>
PUBSUB_PUSH_SERVICE_ACCOUNT=<push subscription service account email>
